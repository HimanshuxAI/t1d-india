# MLflow Project Configuration for T1D Hypoglycemia Prediction

name: t1d-hypo-prediction

conda_env: conda.yaml

docker_env:
  image: pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime
  build_steps:
    - RUN pip install mlflow==2.12.0 onnx==1.15.0 onnxruntime==1.16.0 optuna==3.4.0 pyyaml==6.0.1

entry_points:
  prepare_data:
    command: "python -m apps.ml_service.src.training.prepare_training_data --data-dir {data_dir} --output {output_path}"
    parameters:
      - name: data_dir
        type: string
        default: /data/synthetic
      - name: output_path
        type: string
        default: /data/training_features.parquet
  
  train:
    command: "python -m apps.ml_service.src.training.run_training --config {config_path} --data-dir {data_dir} --output-dir {output_dir} --epochs {epochs} --batch-size {batch_size} --lr {lr} --device {device} --mlflow-uri {mlflow_uri}"
    parameters:
      - name: config
        type: string
        default: mlflow_config.yaml
      - name: data_dir
        type: string
        default: /data/synthetic
      - name: output_dir
        type: string
        default: /models
      - name: epochs
        type: integer
        default: 100
      - name: batch_size
        type: integer
        default: 64
      - name: lr
        type: float
        default: 0.001
      - name: device
        type: string
        default: cuda
      - name: mlflow_uri
        type: string
        default: http://mlflow:5000
      - name: optimize
        type: boolean
        default: false
      - name: n_trials
        type: integer
        default: 20

  optimize:
    command: "python -m apps.ml_service.src.training.run_training --config {config} --data-dir {data_dir} --output-dir {output_dir} --optimize --n-trials {n_trials} --mlflow-uri {mlflow_uri}"
    parameters:
      - name: config
        type: string
        default: mlflow_config.yaml
      - name: data_dir
        type: string
        default: /data/synthetic
      - name: output_dir
        type: string
        default: /models
      - name: n_trials
        type: integer
        default: 50
      - name: mlflow_uri
        type: string
        default: http://mlflow:5000

  export_onnx:
    command: "python -c \"from apps.ml_service.src.training.train_tft import export_to_onnx, TFTConfig, TFTForHypoPrediction; import torch; config = TFTConfig(); model = TFTForHypoPrediction(config); model.load_state_dict(torch.load('{model_path}')); export_to_onnx(model, config, '{output_path}')\""
    parameters:
      - name: model_path
        type: string
      - name: output_path
        type: string
        default: /models/tft_hypo_predictor.onnx

  evaluate:
    command: "python -m apps.ml_service.src.training.evaluate_model --model-path {model_path} --data-path {data_path} --output {output_path}"
    parameters:
      - name: model_path
        type: string
      - name: data_path
        type: string
        default: /data/synthetic
      - name: output_path
        type: string
        default: /models/evaluation_report.json