# T1D India - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================
# DATABASE (PostgreSQL + TimescaleDB)
# ============================================
DATABASE_URL=postgresql://t1d:password@localhost:5432/t1d?schema=public

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# AUTHENTICATION (Clerk)
# ============================================
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# JWT (fallback if not using Clerk)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CGM VENDOR APIS
# ============================================
# Dexcom (G6/G7)
DEXCOM_CLIENT_ID=your_dexcom_client_id
DEXCOM_CLIENT_SECRET=your_dexcom_client_secret
DEXCOM_REDIRECT_URI=http://localhost:3000/api/auth/callback/dexcom
DEXCOM_SANDBOX=true

# Abbott Libre (LibreView)
LIBRE_CLIENT_ID=your_libre_client_id
LIBRE_CLIENT_SECRET=your_libre_client_secret

# Medtronic Guardian
MEDTRONIC_CLIENT_ID=your_medtronic_client_id
MEDTRONIC_CLIENT_SECRET=your_medtronic_client_secret
MEDTRONIC_REDIRECT_URI=http://localhost:3000/api/auth/callback/medtronic

# ============================================
# ML SERVICE
# ============================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=dev-ml-key-change-in-production

# ============================================
# STORAGE (S3/MinIO)
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MODELS=t1d-models
S3_BUCKET_PHOTOS=t1d-meal-photos
S3_REGION=ap-south-1

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=
GRAFANA_API_KEY=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_SWAGGER=true
ENABLE_METRICS=true

# ============================================
# FRONTEND (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
NEXT_PUBLIC_WS_URL=ws://localhost:8001
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register